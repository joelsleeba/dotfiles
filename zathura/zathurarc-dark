set selection-clipboard clipboard
set continuous-hist-save true
set database sqlite

# Theme
set default-bg "#1d2021"
set font "Arimo Nerd Font 10"
set guioptions ''
set recolor true
set recolor-darkcolor "#f9f5d7"
set recolor-keephue true
set recolor-lightcolor "#181818"
set recolor-reverse-video true

# Smooth Scrolling
map j scroll smooth-down
map k scroll smooth-up
